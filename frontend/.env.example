# ====================================================================
# AM to PM Mobility — Environment Configuration Template
# ====================================================================

# Set to 'false' when connecting to your live backend server
VITE_USE_MOCK_BACKEND=true

# Backend REST API Base URL
VITE_API_BASE_URL=https://api.amtopm.example.com

# 1. Razorpay Payment Gateway Keys (https://dashboard.razorpay.com/#/app/keys)
VITE_RAZORPAY_KEY_ID=rzp_test_YourKeyHere
VITE_RAZORPAY_KEY_SECRET=YourSecretHere

# 2. Google Maps Platform API Key (https://console.cloud.google.com)
VITE_GOOGLE_MAPS_API_KEY=AIzaSyYourMapsKeyHere

# 3. WhatsApp Business Cloud API (https://developers.facebook.com)
VITE_MESSAGING_PROVIDER=mock
VITE_WHATSAPP_TOKEN=EAAGYourMetaSystemTokenHere
VITE_WHATSAPP_PHONE_ID=109283746591029

# Alternative SMS: Twilio
VITE_TWILIO_ACCOUNT_SID=ACYourTwilioAccountSid
VITE_TWILIO_AUTH_TOKEN=YourTwilioAuthToken
VITE_TWILIO_FROM_NUMBER=+1234567890

# 4. Firebase Cloud Messaging (FCM)
VITE_FIREBASE_API_KEY=AIzaSyYourFirebaseApiKey
VITE_FIREBASE_AUTH_DOMAIN=am-to-pm.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=am-to-pm
VITE_FIREBASE_STORAGE_BUCKET=am-to-pm.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789012
VITE_FIREBASE_APP_ID=1:123456789012:web:abcdef123456
VITE_FIREBASE_VAPID_KEY=BNYourWebPushVapidKeyHere
